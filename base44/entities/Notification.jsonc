{
  "name": "Notification",
  "type": "object",
  "properties": {
    "incident_id": {
      "type": "string"
    },
    "case_number": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "teacher_email": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "incident_id",
    "message"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}