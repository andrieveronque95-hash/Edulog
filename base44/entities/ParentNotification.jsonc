{
  "name": "ParentNotification",
  "type": "object",
  "properties": {
    "incident_id": {
      "type": "string"
    },
    "case_number": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "High",
        "Critical"
      ]
    },
    "subject": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Sent",
        "Failed"
      ],
      "default": "Sent"
    },
    "error": {
      "type": "string"
    },
    "attachments_sent": {
      "type": "string"
    },
    "is_resend": {
      "type": "boolean",
      "default": false
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "incident_id",
    "recipient_email",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}