{
  "name": "Student",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "grade_level": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "department": {
      "type": "string",
      "enum": [
        "Preschool",
        "Primary",
        "Secondary",
        "Junior High School"
      ]
    },
    "gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female",
        "Other"
      ]
    },
    "guardian_name": {
      "type": "string"
    },
    "guardian_email": {
      "type": "string"
    },
    "guardian_contact": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive",
        "Transferred"
      ],
      "default": "Active"
    },
    "notes": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "student_id",
    "full_name",
    "department"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}